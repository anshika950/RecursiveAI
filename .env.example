# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model Configuration
MODEL_TYPE=ollama  # Options: ollama, huggingface
MODEL_NAME=mistral  # For Ollama: mistral, llama2, neural-chat, etc.
OLLAMA_BASE_URL=http://localhost:11434  # Ollama server URL
HF_API_TOKEN=  # Hugging Face API token (if using HF)

# Database
DATABASE_URL=sqlite:///./app.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Google OAuth (optional) - create credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client ID,
# type "Web application"). Add GOOGLE_REDIRECT_URI below as an
# authorized redirect URI in that console. Without these set, the
# /auth/oauth/google/* endpoints return a clear 503 instead of crashing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
